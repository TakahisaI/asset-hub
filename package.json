{
  "name": "asset-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "check": "tsc --noEmit",
    "build": "vite build",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run check && npm test && npm run build",
    "thumbnails": "tsx tools/thumbnails.ts",
    "assetctl": "tsx tools/assetctl.ts",
    "test:browser": "tsx tests/browser.ts",
    "validate:assets": "tsx tools/validate.ts",
    "format:check": "prettier --check .",
    "verify:full": "npm run format:check && npm run verify && npm run test:browser"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "express": "^5.3.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "files": [
    "src",
    "server",
    "tools",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "README.md",
    "package-lock.json",
    "tests",
    "docs"
  ]
}
